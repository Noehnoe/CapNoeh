def wine_env():
    env = os.environ.copy()
    env["WINEPREFIX"] = PREFIX
    env.setdefault("WINEDEBUG", "-all")
    return env


def is_installed():
    return os.path.exists(CAPCUT_HOST)


def find_wine():
    return shutil.which("wine") or (
        "/opt/wine-staging/bin/wine"
        if os.path.exists("/opt/wine-staging/bin/wine")
        else None
    )


def wine_version():
    w = find_wine()
    if not w:
        return None
    try:
        out = subprocess.run(
            [w, "--version"], capture_output=True, text=True, timeout=15
        )
        return out.stdout.strip() or None
    except Exception:  # noqa: BLE001
        return None


def update_blocked():
    if not os.path.exists(GLOBAL_SETTING):
        return None
    try:
        with open(GLOBAL_SETTING, encoding="utf-8", errors="replace") as f:
            return "enableAutoUpdate=false" in f.read()
    except OSError:
        return None


def sha256_of(path, progress=None):
    h = hashlib.sha256()
    total = os.path.getsize(path) or 1
    read = 0
    with open(path, "rb") as f:
        while chunk := f.read(1024 * 1024):
            h.update(chunk)
            read += len(chunk)
            if progress:
                progress(read / total)
    return h.hexdigest()


def verify_signature(path):
    """Check the ByteDance Authenticode signature. Returns (ok, message)."""
    try:
        from signify.authenticode.signed_file import SignedPEFile
    except ImportError:
        return None, "signify not installed — skipped (pip install --user signify)"
    try:
        with open(path, "rb") as f:
            pe = SignedPEFile(f)
            status, err = pe.explain_verify()
            if str(status) != "AuthenticodeVerificationResult.OK":
                return False, f"signature INVALID — {err}"
            for sig in pe.signatures:
                for cert in sig.certificates:
                    if "ytedance" in cert.subject.dn:
                        return True, "valid — signed by Bytedance Pte. Ltd."
            return True, "valid signature (signer name not matched)"
    except Exception as exc:  # noqa: BLE001
        return False, f"could not verify — {exc}"


