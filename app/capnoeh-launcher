    def _set_chips(self, items):
        for child in self.chips.get_children():
            self.chips.remove(child)
        for text, kind in items:
            self.chips.pack_start(self._chip(text, kind), False, False, 0)
        self.chips.show_all()

    def _set_meta(self, rows):
        for child in self.grid.get_children():
            self.grid.remove(child)
        for i, (k, v) in enumerate(rows):
            kl = Gtk.Label(label=k)
            kl.get_style_context().add_class("meta-key")
            kl.set_xalign(0)
            vl = Gtk.Label(label=v)
            vl.get_style_context().add_class("meta-val")
            vl.set_xalign(0)
            vl.set_selectable(True)
            vl.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            self.grid.attach(kl, 0, i, 1, 1)
            self.grid.attach(vl, 1, i, 1, 1)
        self.grid.show_all()

    # ---------- helpers ----------

    def log(self, text, tag=None):
        def append():
            buf = self.logview.get_buffer()
            end = buf.get_end_iter()
            if tag:
                buf.insert_with_tags_by_name(end, text + "\n", tag)
            else:
                buf.insert(end, text + "\n")
            self.logview.scroll_to_mark(buf.get_insert(), 0.0, False, 0, 0)
            return False

        GLib.idle_add(append)

    def set_status(self, markup):
        GLib.idle_add(lambda: self.status.set_markup(markup) or False)

    def set_busy(self, busy):
        self.busy = busy

        def apply():
            self.primary.set_sensitive(not busy)
            self.secondary.set_sensitive(not busy)
            self.progress.set_visible(busy)
            if busy and not self.log_toggle.get_active():
                self.log_toggle.set_active(True)
            if not busy:
                self.progress.set_fraction(0.0)
            return False

        GLib.idle_add(apply)

    def refresh(self):
        wv = wine_version()
        if not wv:
            self._set_chips([("Wine not found", "bad")])
            self.set_status(
                "<b>Wine is not installed.</b>  Install wine-staging, then reopen "
                f"{APP_NAME}."
            )
            self.primary.set_label("Wine missing")
            self.primary.set_sensitive(False)
            self.secondary.set_visible(False)
            self._set_meta([("Expected", "wine-staging (not Proton/Bottles)")])
            return

        if is_installed():
            blocked = update_blocked()
            chips = [(f"CapCut {CAPCUT_VERSION}", "ok"), (wv, None)]
            if blocked is True:
                chips.append(("Auto-update blocked", "ok"))
            elif blocked is False:
                chips.append(("Auto-update NOT blocked", "bad"))
            self._set_chips(chips)

            if blocked is False:
                self.set_status(
                    "<span foreground='#ff5f6d'><b>Auto-update is not blocked.</b></span>  "
                    "CapCut may replace itself with the 9.x build, which cannot run "
                    "under Wine. Use Repair to fix this."
                )
                self.secondary.set_label("Repair")
            else:
                self.set_status("Ready.")
                self.secondary.set_label("Reinstall…")

            self.primary.set_label("Launch CapCut")
            self.primary.set_sensitive(True)
            self.secondary.set_visible(True)
            self._set_meta(
                [
                    ("Version", CAPCUT_VERSION),
                    ("Prefix", PREFIX),
                    ("Wine", wv),
                    (
                        "Auto-update",
                        {True: "blocked", False: "NOT blocked", None: "unknown"}[
                            blocked
                        ],
                    ),
                ]
            )
        else:
            self._set_chips([("Not installed", "warn"), (wv, None)])
            self.set_status(
                f"Select the CapCut {CAPCUT_VERSION} installer and {APP_NAME} will "
                "verify it, set up an isolated Wine prefix, and block the auto-update "
                "that would otherwise break it.\n"
                "<span foreground='#6b7789'>Nothing is downloaded for you — supply "
                "the installer yourself.</span>"
            )
            self.primary.set_label("Select CapCut installer…")
            self.primary.set_sensitive(True)
            self.secondary.set_visible(False)
            self._set_meta(
                [("Prefix", PREFIX), ("Wine", wv), ("Expected SHA-256", KNOWN_SHA256)]
            )

    # ---------- actions ----------

    def on_primary(self, _btn):
        if is_installed():
            self.launch()
        else:
            self.on_install_clicked(None)

    def launch(self):
        wine = find_wine()
        self.log(f"Launching {CAPCUT_WIN}")
        try:
            subprocess.Popen(
                [wine, CAPCUT_WIN],
                env=wine_env(),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            self.log("CapCut started.", "ok")
            self.set_status("CapCut is starting…")
        except Exception as exc:  # noqa: BLE001
            self.log(f"Failed to launch: {exc}", "bad")

    def on_install_clicked(self, _btn):
        if is_installed() and self.secondary.get_label() == "Repair":
            threading.Thread(target=self.repair, daemon=True).start()
            return

        dialog = Gtk.FileChooserDialog(
            title=f"Select the CapCut {CAPCUT_VERSION} installer",
            parent=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dialog.add_buttons(
            "Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK
        )
        flt = Gtk.FileFilter()
        flt.set_name("CapCut installer (*.exe)")
        flt.add_pattern("*.exe")
        dialog.add_filter(flt)
        downloads = os.path.join(HOME, "Downloads")
        if os.path.isdir(downloads):
            dialog.set_current_folder(downloads)
        if dialog.run() == Gtk.ResponseType.OK:
            path = dialog.get_filename()
            dialog.destroy()
            threading.Thread(target=self.install, args=(path,), daemon=True).start()
        else:
            dialog.destroy()

    # ---------- install ----------

    def repair(self):
        self.set_busy(True)
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            existing = ""
            if os.path.exists(GLOBAL_SETTING):
                with open(GLOBAL_SETTING, encoding="utf-8", errors="replace") as f:
                    existing = f.read()
            keep = [
                ln
                for ln in existing.splitlines(True)
                if not ln.startswith("[General]")
                and not ln.split("=")[0]
                in (
                    "enableAutoUpdate",
                    "totalSilentUpgradeSwitch",
                    "localTestSilentUpdateSwtich",
                    "debugSilentUpgradeSwitch",
                    "user_license_agreed",
                    "privacy_policy_update_time",
                )
            ]
            with open(GLOBAL_SETTING, "w", encoding="utf-8", newline="") as f:
                f.write(UPDATE_BLOCK)
                f.writelines(keep)
            self.log("Re-applied the auto-update block.", "ok")
            self.configure_file_dialog()
            self.set_status("Repaired.")
        except Exception as exc:  # noqa: BLE001
            self.log(f"Repair failed: {exc}", "bad")
        finally:
            self.set_busy(False)
            GLib.idle_add(lambda: self.refresh() or False)

    def install(self, installer):
        self.set_busy(True)
        try:
            self.log(f"Installer: {installer}", "dim")

            size = os.path.getsize(installer)
            if size == KNOWN_SIZE:
                self.log(f"Size {size} bytes — matches.", "ok")
            else:
                self.log(f"Size {size} bytes — expected {KNOWN_SIZE}.", "warn")

            self.set_status("Verifying checksum…")
            digest = sha256_of(
                installer, lambda f: GLib.idle_add(self.progress.set_fraction, f)
            )
            self.log(f"SHA-256 {digest}", "dim")

            if digest != KNOWN_SHA256:
                self.log("Checksum does NOT match the known-good build.", "bad")
                if not self.confirm_mismatch():
                    self.log("Install cancelled.", "warn")
                    return
            else:
                self.log("Checksum matches the known-good build.", "ok")

            self.set_status("Verifying signature…")
            ok, msg = verify_signature(installer)
            self.log(
                f"Authenticode: {msg}",
                "ok" if ok else ("bad" if ok is False else "warn"),
            )
            if ok is False and not self.confirm_bad_signature(msg):
                self.log("Install cancelled.", "warn")
                return

            wine = find_wine()
            self.set_status("Preparing the Wine prefix…")
            subprocess.run(
                [wine, "wineboot", "-i"],
                env=wine_env(),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            self.log("Wine prefix ready.", "ok")

            # The installer hangs unless these exist beforehand.
            for d in (APPDATA, CONFIG_DIR, f"{APPDATA}/User Data/Log"):
                os.makedirs(d, exist_ok=True)
            self.log("Created the directories the installer needs.", "ok")

            with open(GLOBAL_SETTING, "w", encoding="utf-8", newline="") as f:
                f.write(UPDATE_BLOCK)
            self.log("Blocked auto-update before first launch.", "ok")

            self.set_status("Running the CapCut installer — follow its prompts…")
            subprocess.run(
                [wine, installer],
                env=wine_env(),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

            if is_installed():
                self.log("CapCut installed.", "ok")
                self.configure_file_dialog()
                GLib.idle_add(lambda: self._load_logo() or False)
                self.set_status("Install complete.")
            else:
                self.log("CapCut.exe not found — install may not have finished.", "bad")
                self.set_status("Install did not complete. Open Details.")
        except Exception as exc:  # noqa: BLE001
            self.log(f"Error: {exc}", "bad")
            self.set_status("Something went wrong. Open Details.")
        finally:
            self.set_busy(False)
            GLib.idle_add(lambda: self.refresh() or False)

    def configure_file_dialog(self):
        """Wine's file picker hides your home folders; surface them."""
        wine = find_wine()
        key = (
            r"HKCU\Software\Microsoft\Windows\CurrentVersion"
            r"\Policies\Comdlg32\Placesbar"
        )
        for name, typ, data in (
            ("Place0", "REG_SZ", rf"C:\users\{USER}\Downloads"),
            ("Place1", "REG_SZ", rf"C:\users\{USER}\Videos"),
            ("Place2", "REG_SZ", rf"C:\users\{USER}\Pictures"),
            ("Place3", "REG_SZ", rf"C:\users\{USER}"),
            ("Place4", "REG_DWORD", "17"),  # CSIDL_DRIVES
        ):
            subprocess.run(
                [wine, "reg", "add", key, "/v", name, "/t", typ, "/d", data, "/f"],
                env=wine_env(),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

        dosdev = f"{PREFIX}/dosdevices"
        os.makedirs(dosdev, exist_ok=True)
        for letter, target in (
            ("d:", f"{HOME}/Downloads"),
            ("v:", f"{HOME}/Videos"),
            ("p:", f"{HOME}/Pictures"),
            ("h:", HOME),
        ):
            if not os.path.isdir(target):
                continue
            link = os.path.join(dosdev, letter)
            if os.path.islink(link):
                os.unlink(link)
            if not os.path.exists(link):
                os.symlink(target, link)
            subprocess.run(
                [wine, "reg", "add", r"HKLM\Software\Wine\Drives",
                 "/v", letter, "/d", "hd", "/f"],
                env=wine_env(),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        self.log("Added Downloads/Videos/Pictures/Home to the file dialog.", "ok")

    # ---------- confirmations ----------

    def _ask(self, primary, secondary):
        result = {}
        done = threading.Event()

        def show():
            dlg = Gtk.MessageDialog(
                transient_for=self,
                modal=True,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text=primary,
            )
            dlg.format_secondary_text(secondary)
            dlg.add_buttons(
                "Cancel", Gtk.ResponseType.CANCEL,
                "Install anyway", Gtk.ResponseType.ACCEPT,
            )
            result["ok"] = dlg.run() == Gtk.ResponseType.ACCEPT
            dlg.destroy()
            done.set()
            return False

        GLib.idle_add(show)
        done.wait()
        return result.get("ok", False)

    def confirm_mismatch(self):
        return self._ask(
            "This is not the build CapNoeh knows about.",
            "The checksum does not match CapCut 3.9.0.1459. It could be a "
            "different version, a corrupted download, or something else "
            "entirely.\n\nOnly continue if you know exactly where this file "
            "came from.",
        )

    def confirm_bad_signature(self, msg):
        return self._ask(
            "The installer's signature did not verify.",
            f"{msg}\n\nA genuine CapCut installer is signed by ByteDance. "
            "A failed check means the file may have been modified.\n\n"
            "Continuing is not recommended.",
        )


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )
    Gtk.Settings.get_default().set_property(
        "gtk-application-prefer-dark-theme", True
    )

    win = Launcher()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.progress.set_visible(False)
    win.revealer.set_reveal_child(False)
    Gtk.main()


if __name__ == "__main__":
    main()
